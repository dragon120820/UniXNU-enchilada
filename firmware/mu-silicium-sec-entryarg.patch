diff --git a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
index 0c05ffa..e7e9931 100644
--- a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
+++ b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
@@ -13,6 +13,12 @@
 .set CTRL_SPAN_BIT, BIT23
 
 ASM_FUNC (_ModuleEntryPoint)
+  // A Linux-style boot loader passes the physical address of a flattened
+  // device tree in x0 and every step below overwrites x0. x19 is callee
+  // saved across the calls that follow. Writing memory here would fault
+  // before the exception vectors and the stack exist, with no way to
+  // report it, so the value waits in a register.
+  mov   x19, x0
   // Do Platform Specific Initialization
   bl    ASM_PFX (PlatformAssemblyInitialize)
 
@@ -50,6 +56,10 @@ ASM_PFX (MainEntryPoint):
   cmp   x0, x2
   b.lt  0b
 
+  // The stack is live now, so the saved argument can go to memory.
+  adr   x1, ASM_PFX (gSecEntryArg0)
+  str   x19, [x1]
+
   // Set Jump Location
   ldr   x0, =ASM_PFX (SecEntry)
 
@@ -61,3 +71,9 @@ ASM_PFX (MainEntryPoint):
 
   // Do Infinite Spin
   b     .
+
+  // First argument of the previous stage, written once the stack exists.
+  .align 3
+  .global ASM_PFX (gSecEntryArg0)
+ASM_PFX (gSecEntryArg0):
+  .quad 0
diff --git a/Silicon/Silicium/SiliciumPkg/Sec/Sec.c b/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
index 8d586b3..eaf8af5 100644
--- a/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
+++ b/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
@@ -18,6 +18,13 @@
 
 #include "Sec.h"
 
+//
+// The first argument the previous stage was entered with, captured by
+// ModuleEntryPoint.S. A Linux-style boot loader puts the physical address of
+// a flattened device tree there.
+//
+extern UINT64  gSecEntryArg0;
+
 #ifndef MDEPKG_NDEBUG
 STATIC
 VOID
@@ -133,6 +140,19 @@ SecMain (VOID)
   // Run Library Cconstructors
   ProcessLibraryConstructorList ();
 
+  //
+  // Hand the argument on to DXE. UniXNURamDiskDxe reads this HOB to learn
+  // where the boot loader put the initrd; without it the driver gives up and
+  // no payload volume is published, so the menu shows the built-in
+  // configuration. Nothing is read or reserved here on purpose: a bogus
+  // value is rejected by the driver, which keeps the firmware bootable.
+  //
+  BuildGuidDataHob (
+    &gSiliciumEntryArgHobGuid,
+    &gSecEntryArg0,
+    sizeof (gSecEntryArg0)
+    );
+
   // Decompress all FVs
   Status = DecompressFirstFv ();
   if (EFI_ERROR (Status)) {
