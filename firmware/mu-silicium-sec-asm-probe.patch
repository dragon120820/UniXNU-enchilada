diff --git a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
index 0c05ffa..e7e9931 100644
--- a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
+++ b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
@@ -13,6 +13,12 @@
 .set CTRL_SPAN_BIT, BIT23
 
 ASM_FUNC (_ModuleEntryPoint)
+  // A Linux-style boot loader passes the physical address of a flattened
+  // device tree in x0 and every step below overwrites x0. x19 is callee
+  // saved across the calls that follow. Writing memory here would fault
+  // before the exception vectors and the stack exist, with no way to
+  // report it, so the value waits in a register.
+  mov   x19, x0
   // Do Platform Specific Initialization
   bl    ASM_PFX (PlatformAssemblyInitialize)
 
@@ -50,6 +56,10 @@ ASM_PFX (MainEntryPoint):
   cmp   x0, x2
   b.lt  0b
 
+  // The stack is live now, so the saved argument can go to memory.
+  adr   x1, ASM_PFX (gSecEntryArg0)
+  str   x19, [x1]
+
   // Set Jump Location
   ldr   x0, =ASM_PFX (SecEntry)
 
@@ -61,3 +71,9 @@ ASM_PFX (MainEntryPoint):
 
   // Do Infinite Spin
   b     .
+
+  // First argument of the previous stage, written once the stack exists.
+  .align 3
+  .global ASM_PFX (gSecEntryArg0)
+ASM_PFX (gSecEntryArg0):
+  .quad 0