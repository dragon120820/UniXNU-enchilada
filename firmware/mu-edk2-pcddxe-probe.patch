diff --git a/MdeModulePkg/Core/Dxe/Dispatcher/Dispatcher.c b/MdeModulePkg/Core/Dxe/Dispatcher/Dispatcher.c
index 4c9df94..ec0b3e0 100644
--- a/MdeModulePkg/Core/Dxe/Dispatcher/Dispatcher.c
+++ b/MdeModulePkg/Core/Dxe/Dispatcher/Dispatcher.c
@@ -1495,4 +1495,48 @@ CoreDisplayDiscoveredNotDispatched (
       DEBUG ((DEBUG_LOAD, "Driver %g was discovered but not loaded!!\n", &DriverEntry->FileName));
     }
   }
+  //
+  // PROBE: dump the dispatcher state of the drivers that starve when the PCD
+  // protocol is missing, plus whether that protocol exists at all. Printed
+  // last so it survives on a screen that only shows the tail of the log.
+  //
+  {
+    EFI_STATUS      ProbeStatus;
+    VOID            *ProbeInterface;
+    LIST_ENTRY      *ProbeLink;
+    EFI_CORE_DRIVER_ENTRY  *ProbeEntry;
+    UINTN           ProbeTotal = 0;
+    UINTN           ProbeDependent = 0;
+    CONST EFI_GUID  ProbePcdDxeGuid = { 0x80CF7257, 0x87AB, 0x47F9, { 0xA3, 0xFE, 0xD5, 0x0B, 0x76, 0xD8, 0x95, 0x41 } };
+    CONST EFI_GUID  ProbeMonoGuid   = { 0xFCABE6A7, 0x7953, 0x4A84, { 0xB7, 0xEC, 0xD2, 0x9E, 0x89, 0xB6, 0x2E, 0x87 } };
+    CONST EFI_GUID  ProbeResetGuid  = { 0x4B28E4C7, 0xFF36, 0x4E10, { 0x93, 0xCF, 0xA8, 0x21, 0x59, 0xE7, 0x77, 0xC5 } };
+    CONST EFI_GUID  ProbeRtcGuid    = { 0xB336F62D, 0x4135, 0x4A55, { 0xAE, 0x4E, 0x49, 0x71, 0xBB, 0xF0, 0x88, 0x5D } };
+    CONST EFI_GUID  ProbeCapsuleGuid = { 0x42857F0A, 0x13F2, 0x4B21, { 0x8A, 0x23, 0x53, 0xD3, 0xF7, 0x14, 0xB8, 0x40 } };
+
+    for (ProbeLink = mDiscoveredList.ForwardLink; ProbeLink != &mDiscoveredList; ProbeLink = ProbeLink->ForwardLink) {
+      ProbeEntry = CR (ProbeLink, EFI_CORE_DRIVER_ENTRY, Link, EFI_CORE_DRIVER_ENTRY_SIGNATURE);
+      ProbeTotal++;
+      if (ProbeEntry->Dependent) {
+        ProbeDependent++;
+      }
+    }
+
+    ProbeStatus = gBS->LocateProtocol (&gEfiPcdProtocolGuid, NULL, &ProbeInterface);
+    DEBUG ((DEBUG_ERROR, "PCDPROBE: discovered=%d dependent=%d LocateProtocol(gEfiPcdProtocol)=%r iface=%p\n", ProbeTotal, ProbeDependent, ProbeStatus, ProbeInterface));
+
+    for (ProbeLink = mDiscoveredList.ForwardLink; ProbeLink != &mDiscoveredList; ProbeLink = ProbeLink->ForwardLink) {
+      ProbeEntry = CR (ProbeLink, EFI_CORE_DRIVER_ENTRY, Link, EFI_CORE_DRIVER_ENTRY_SIGNATURE);
+      if (CompareGuid (&ProbeEntry->FileName, &gEfiVariableArchProtocolGuid) ||
+          CompareGuid (&ProbeEntry->FileName, &ProbePcdDxeGuid) ||
+          CompareGuid (&ProbeEntry->FileName, &ProbeMonoGuid) ||
+          CompareGuid (&ProbeEntry->FileName, &ProbeResetGuid) ||
+          CompareGuid (&ProbeEntry->FileName, &ProbeRtcGuid) ||
+          CompareGuid (&ProbeEntry->FileName, &ProbeCapsuleGuid))
+      {
+        DEBUG ((DEBUG_ERROR, "PCDPROBE: %g dep=%d init=%d sched=%d untrusted=%d depexerr=%d fv=%p image=%p\n",
+          &ProbeEntry->FileName, ProbeEntry->Dependent, ProbeEntry->Initialized, ProbeEntry->Scheduled,
+          ProbeEntry->Untrusted, ProbeEntry->DepexProtocolError, ProbeEntry->Fv, ProbeEntry->ImageHandle));
+      }
+    }
+  }
 }
