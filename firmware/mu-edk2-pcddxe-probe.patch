diff --git a/MdeModulePkg/Core/Dxe/Dispatcher/Dispatcher.c b/MdeModulePkg/Core/Dxe/Dispatcher/Dispatcher.c
index 4c9df94..6159c84 100644
--- a/MdeModulePkg/Core/Dxe/Dispatcher/Dispatcher.c
+++ b/MdeModulePkg/Core/Dxe/Dispatcher/Dispatcher.c
@@ -33,6 +33,14 @@ SPDX-License-Identifier: BSD-2-Clause-Patent
 
 #include "DxeMain.h"
 
+//
+// PROBE: remember why each driver image failed to load.
+//
+#define PROBE_LOAD_MAX  64
+STATIC EFI_GUID    ProbeLoadGuid[PROBE_LOAD_MAX];
+STATIC EFI_STATUS  ProbeLoadStatus[PROBE_LOAD_MAX];
+STATIC UINTN       ProbeLoadCount = 0;
+
 //
 // The Driver List contains one copy of every driver that has been discovered.
 // Items are never removed from the driver list. List of EFI_CORE_DRIVER_ENTRY
@@ -466,6 +474,11 @@ CoreDispatcher (
         // Update the driver state to reflect that it's been loaded
         //
         if (EFI_ERROR (Status)) {
+          if (ProbeLoadCount < PROBE_LOAD_MAX) {
+            CopyGuid (&ProbeLoadGuid[ProbeLoadCount], &DriverEntry->FileName);
+            ProbeLoadStatus[ProbeLoadCount] = Status;
+            ProbeLoadCount++;
+          }
           CoreAcquireDispatcherLock ();
 
           if (Status == EFI_SECURITY_VIOLATION) {
@@ -1495,4 +1508,15 @@ CoreDisplayDiscoveredNotDispatched (
       DEBUG ((DEBUG_LOAD, "Driver %g was discovered but not loaded!!\n", &DriverEntry->FileName));
     }
   }
+  //
+  // PROBE: drivers whose image never loaded, with the CoreLoadImage status.
+  // Printed last so it survives on a screen that only shows the log tail.
+  //
+  {
+    UINTN  Index;
+    DEBUG ((DEBUG_ERROR, "PCDPROBE: LoadImage failures = %d\n", ProbeLoadCount));
+    for (Index = 0; Index < ProbeLoadCount; Index++) {
+      DEBUG ((DEBUG_ERROR, "PCDPROBE: %g -> %r\n", &ProbeLoadGuid[Index], ProbeLoadStatus[Index]));
+    }
+  }
 }
